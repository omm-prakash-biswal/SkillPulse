# Security & Debug settings
SECRET_KEY=field-atlas-local-secret-key-dev-environment-secure-token-987654321
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite for local development; set USE_MYSQL=True for MySQL)
USE_MYSQL=False
DB_NAME=field_atlas
DB_USER=root
DB_PASSWORD=password
DB_HOST=127.0.0.1
DB_PORT=3306

# Email Configuration (Uses console backend for local dev so 6-digit OTPs display in terminal/logs)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL="Field Atlas <noreply@fieldatlas.in>"
